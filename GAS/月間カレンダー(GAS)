// 月間カレンダー

// 定数宣言
const WEEK = 8;
const WEEK_ARRAY = 7;
const MONTH_START = 1;
const MONTH_END = 12;
const YEAR_START = 1900;
const YEAR_END = 2100;  

// 処理開始
function calender() {

  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();

  // 初期化
  sheet.clear();

  // 【修正】年入力の処理を追加
  let year;
  do {
    year = Number(
      SpreadsheetApp.getUi().prompt(
        "年を入力してください(1900~2100)"
      ).getResponseText()
    );
  } while (year < YEAR_START || year > YEAR_END || isNaN(year));

  // 月入力
  let month;
  do {
    month = Number(
      SpreadsheetApp.getUi().prompt(
        "月を入力してください(1~12)"
      ).getResponseText()
    );
  } while (month < MONTH_START || month > MONTH_END || isNaN(month));

  // 曜日
  const weekdays = ["日", "月", "火", "水", "木", "金", "土"];

  // 【修正】for文の後ろの不要なセミコロン「;」を削除
  for (let col = 0; col < WEEK_ARRAY; col++) {
    const cell = sheet.getRange(2, col + 1);

    cell.setValue(weekdays[col]);
    cell.setHorizontalAlignment("center");
    cell.setFontWeight("bold");
  }

  // 月初・月末取得
  const startDate = new Date(year, month - 1, 1);
  const lastDay = new Date(year, month, 0).getDate();

  let row = 3;

  // 0=日曜日 ➔ GASの列番号に合わせるため +1
  let column = startDate.getDay() + 1;

  // 日付入力
  for (let dayCnt = 1; dayCnt <= lastDay; dayCnt++) {

    const cell = sheet.getRange(row, column);

    cell.setValue(dayCnt);
    cell.setFontSize(15);
    cell.setVerticalAlignment("top");
    cell.setHorizontalAlignment("left");

    // 日曜
    if (column === 1) {
      cell.setFontColor("red");
    }
    // 土曜
    else if (column === 7) {
      cell.setFontColor("blue");
    }

    column++;

    if (column > WEEK_ARRAY) {
      column = 1;
      row++; // 【修正】制限をなくし、次の行へ進める
    }
  }

  // タイトル
  sheet.getRange("A1:G1").merge();
  sheet.getRange("A1")
    .setValue(`${year}年${month}月 カレンダー`)
    .setFontSize(25)
    .setHorizontalAlignment("center");

  // レイアウト
  sheet.setColumnWidths(1, 7, 140);

  // 【修正】最終的なrowの番号で行数を判定し、枠線と高さを設定
  if (row > 7) {
    // 6週ある月（最大8行目まで使う）
    for (let r = 3; r <= 8; r++) {
      sheet.setRowHeight(r, 60);
    }
    sheet.getRange("A2:G8").setBorder(
      true, true, true, true, true, true
    );
  } else {
    // 5週で収まる月（7行目まで使う）
    for (let r = 3; r <= 7; r++) {
      sheet.setRowHeight(r, 60);
    }
    sheet.getRange("A2:G7").setBorder(
      true, true, true, true, true, true
    );
  }
}
